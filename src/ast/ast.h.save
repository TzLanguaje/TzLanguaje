#ifndef TZLANG_AST_H
#define TZLANG_AST_H

typedef enum {
    AST_PROGRAM,
    AST_NUMBER,
    AST_STRING,
    AST_IDENTIFIER,
    AST_BINARY,
    AST_VARIABLE_DECLARATION,
    AST_PRINT
} ASTNodeType;

typedef struct ASTNode ASTNode;

struct ASTNode {
    ASTNodeType type;

    union {
        int number;

        char *string;

        char *identifier;

        struct {
            ASTNode *left;
            ASTNode *right;
            char operator;
        } binary;

        struct {
            char *name;
            ASTNode *value;
        } variable;

        ASTNode *print;

    } data;
};

ASTNode *ast_number(int value);
ASTNode *ast_string(const char *value);
ASTNode *ast_identifier(const char *name);

ASTNode *ast_binary(
    ASTNode *left,
    char operator,
    ASTNode *right
);

ASTNode *ast_variable(
    const char *name,
    ASTNode *value
);

ASTNode *ast_print(ASTNode *expression);

void ast_free(ASTNode *node);

