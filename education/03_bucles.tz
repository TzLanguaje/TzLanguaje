// ==========================
// Leccion 3: repetir
// ==========================
//
// Copiar y pegar la misma linea diez
// veces funciona. Repetirla mil, no.

// 'mientras' repite hasta que la
// condicion deje de cumplirse.

variable i = 1

mientras i es menor o igual que 5
    imprimir "Vuelta numero " + texto(i)
    i = i + 1        // sin esta linea, el bucle no acaba nunca
fin

// 'para cada' recorre una lista entera
// sin llevar la cuenta a mano.

variable frutas = ["manzana", "pera", "platano"]

para cada fruta en frutas
    imprimir "Me gusta la " + fruta
fin

// 'romper' sale del bucle antes de tiempo.
// 'continuar' salta a la vuelta siguiente.

variable numeros = [1, 2, 3, 4, 5, 6]

para cada n en numeros
    si n % 2 es diferente de 0
        continuar          // los impares no nos interesan
    fin

    si n es mayor que 4
        romper             // y a partir de 4 paramos
    fin

    imprimir texto(n) + " es par"
fin
